[Unit]
Description=EdgeVision 9000 Gateway - YOLOv8 INT8 detection stream (248B fixed frame)
Documentation=file:///root/lab/w4_edgevision_gateway.cpp
After=network.target

# ===========================================================================
# ✅ 2026-11-20 已在板端实测对齐（本节取代 11-19 的"重建版"）。
#
#   历史：这个 unit 曾长期缺失（control_service 的 gateway -> edgevision，
#   但 lab/services/ 里没有），11-19 依间接证据重建，但**未经板端回读**。
#   2026-11-20 板子在手，逐字回读 `/etc/systemd/system/edgevision.service`，
#   发现板端用的还是**更旧的版本**（`ExecStart=.../dev/video81` 写死 +
#   `Restart=always` + 一个 cam2.conf drop-in 覆盖摄像头）。
#
#   本次处理：**以本文件的新版为准装机**（不是以板端为准），理由：
#     · EnvironmentFile 单一真源 —— 消除"unit 与 drop-in 两处都能改摄像头"，
#       这正是本项目反复踩的"同一件事存两处，迟早有一处是错的"。
#     · `Restart=always` 在摄像头拔掉时会每 5s 拉起一次刷爆 journal；
#       改 on-failure + StartLimit 后，坏设备会安静地停在 failed 等人来看。
#
#   板端实测（2026-11-20 23:59 ~ 00:02）：
#     install 后 daemon-reload + start → active，NRestarts=0，
#     9000 监听就绪，journal 打 `[NPU Core #0] 16.8~21.0 ms | 检出 1 目标`，
#     `strings | grep "x86 Stub Mode"` = 0（真 NPU，非桩）。
#
#   撤销回旧版：恢复 `ExecStart=/root/lab/w4_edgevision_gateway /dev/video81`
#   + `Restart=always`，并把 edgevision-cam2.conf 装回 drop-in 目录。
# ===========================================================================

# 启动限次放在 [Unit] 而不是 [Service]：systemd ≥230 起这两个键的归属段
# 改到了 [Unit]（本板 systemd 247）。写在 [Service] 里仍能工作但会刷
# `Unknown key name ... ignoring` 警告，看着像配置没生效。
StartLimitIntervalSec=120
StartLimitBurst=3

# ⚠️ 与 voice-gateway.service **硬互斥**：两者都要独占 NPU 的 IOMMU 地址空间。
#
#   根因（实测，见 docs/TROUBLESHOOTING.md 第 27 条）：
#     RK3588 NPU 的 IOMMU 只有 **32 位，即 4 GiB** 地址空间 —— 与物理内存 7.5 GB 无关。
#     每个 rkllm 实例约占 ~1.95 GB IOVA。网关/看板先起来的 NPU 上下文已吃掉一块，
#     再叠加一个 rkllm 就让 `dma_map_sg` 超过 4096 MiB → 返回 EFAULT(errno 14)，
#     表现为 `rkllm_init failed: -1` / `failed to malloc npu memory`。
#
#   所以这里必须声明式互斥，而不是靠人记得先停一个。
#   配套的 After= 保证"先停完 voice-gateway，再启动本服务"。
Conflicts=voice-gateway.service
After=voice-gateway.service

[Service]
Type=simple
WorkingDirectory=/root/lab
EnvironmentFile=-/etc/default/edgevision

# 摄像头设备走 EnvironmentFile，不要在 unit 里写死：
#   cam1(/dev/video81) 2026-11-11 起硬件损坏（空闲态 v4l2-ctl 抓帧恒 0 字节），
#   当前在用 cam2(/dev/video83)，见 /etc/default/edgevision 的 GATEWAY_CAM。
#   改 /etc/default/edgevision 后 restart 即可，不用动 unit。
#
# 没有 EnvironmentFile 时（旧装机）$GATEWAY_CAM 会展开成空串，网关自己
# 走 `argc > 1 ? argv[1] : "/dev/video81"` 的默认分支 —— 不会崩，但会落到
# 已损坏的 cam1 上。所以 EnvironmentFile 里的 GATEWAY_CAM 必须存在。
ExecStart=/root/lab/w4_edgevision_gateway $GATEWAY_CAM

# 网关会独占摄像头并持有 NPU 上下文，退出时必须让它按 SIGTERM 正常收尾
# （关 V4L2 流、释放 rknn context、退推流线程），否则残留的 NPU 映射会钉住 IOMMU。
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15

Restart=on-failure
RestartSec=5
# 启动限次见文件顶部 [Unit] 段的 StartLimitIntervalSec / StartLimitBurst

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
